# --- Python bytecode ---------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
env/

# --- Derived / regenerable artifacts -----------------------------------------
# Raw data under data/ IS tracked; everything derived from it is not.
processed/
models/
# Note: the directory itself must not be excluded, or the negation below cannot
# take effect - git will not re-include a file whose parent directory is ignored.
scorer_results/*
# ...except the December chart, which is a required submission artifact.
!scorer_results/candidate_december.png

# --- Test / tooling caches ---------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Notebook checkpoints ----------------------------------------------------
.ipynb_checkpoints/

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
